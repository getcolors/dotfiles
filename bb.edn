{:paths ["test/clj" "test/resources"]
 :deps {io.github.getcolors/dotfiles {:local/root "."}}
 :tasks
 {test
  {:doc "Run the test suite under babashka"
   :requires ([clojure.test :as t]
              [io.github.getcolors.dotfiles.tools-test]
              [io.github.getcolors.dotfiles.validate-test]
              [io.github.getcolors.dotfiles.workflow-test])
   :task (let [{:keys [fail error]}
               (t/run-tests 'io.github.getcolors.dotfiles.tools-test
                            'io.github.getcolors.dotfiles.validate-test
                            'io.github.getcolors.dotfiles.workflow-test)]
           (System/exit (if (pos? (+ fail error)) 1 0)))}

  golden
  {:doc "Render and diff the committed golden output"
   :task (shell "./scripts/golden.sh")}

  golden:accept
  {:doc "Regenerate committed golden output after reviewing a change"
   :task (shell "./scripts/golden.sh" "--accept")}

  pin
  {:doc "Stamp the bundled launcher with this repository's pushed HEAD"
   :task (load-file "tasks/pin.clj")}}}
